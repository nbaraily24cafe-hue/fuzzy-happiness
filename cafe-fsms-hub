# 1. Set the default branch to main
git branch -M main

# 2. Link your local project to your GitHub repository
git remote add origin https://github.com/nbaraily24cafe/cafe-fsms-hub.git

# 3. Push your code to GitHub
git push -u origin main
# 1. Navigate to your project directory (adjust path if needed)
cd path/to/your/project-folder

# 2. Initialize Git tracking in this folder
git init

# 3. Create a README file introducing the project
echo "# ISO 22000 Cafe FSMS Operations Hub" >> README.md

# 4. Stage all files (index.html, manifest.json, sw.js, and README.md)
git add .

# 5. Save the snapshot with an initial commit message
git commit -m "Initial commit: ISO 22000 Cafe FSMS web app"
